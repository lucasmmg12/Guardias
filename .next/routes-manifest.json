{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/adicionales",
      "regex": "^/admin/adicionales(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/adicionales(?:/)?$"
    },
    {
      "page": "/admin/medicos",
      "regex": "^/admin/medicos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/medicos(?:/)?$"
    },
    {
      "page": "/admin/valores-consultas",
      "regex": "^/admin/valores\\-consultas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/valores\\-consultas(?:/)?$"
    },
    {
      "page": "/admisiones",
      "regex": "^/admisiones(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admisiones(?:/)?$"
    },
    {
      "page": "/admisiones/resumenes",
      "regex": "^/admisiones/resumenes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admisiones/resumenes(?:/)?$"
    },
    {
      "page": "/ginecologia",
      "regex": "^/ginecologia(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ginecologia(?:/)?$"
    },
    {
      "page": "/ginecologia/resumenes",
      "regex": "^/ginecologia/resumenes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ginecologia/resumenes(?:/)?$"
    },
    {
      "page": "/guardias-clinicas",
      "regex": "^/guardias\\-clinicas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/guardias\\-clinicas(?:/)?$"
    },
    {
      "page": "/guardias-clinicas/resumenes",
      "regex": "^/guardias\\-clinicas/resumenes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/guardias\\-clinicas/resumenes(?:/)?$"
    },
    {
      "page": "/manual",
      "regex": "^/manual(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manual(?:/)?$"
    },
    {
      "page": "/pediatria",
      "regex": "^/pediatria(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pediatria(?:/)?$"
    },
    {
      "page": "/pediatria/resumenes",
      "regex": "^/pediatria/resumenes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pediatria/resumenes(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}